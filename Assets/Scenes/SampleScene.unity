  m_Name: 
  m_EditorClassIdentifier: 
  message: "\u043A\u043C, \u043D\u0438\u0436\u0435 \u0438\u0434\u0443\u0442 \u0442\u0432\u043E\u0438
    \u0441\u0442\u0440\u0435\u043B\u044B \u043E\u0431\u044B\u0447\u043D\u044B\u0435,
    \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0435 \u0438 \u0441\u0432\u044F\u0442\u044B\u0435!
    \u0441\u0442\u043E\u0438\u0442 \u043B\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u0447\u0442\u043E \u0434\u043B\u044F \u0447\u0435\u0433\u043E? \u0425\u043C\u043C\u043C\u043C
    \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0445\u043E\u0440\u043E\u0448\u043E
    \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0441 \u043B\u044E\u0431\u044B\u043C\u0438
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C\u0438 \u0443
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0435\u0441\u0442\u044C \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
    \u043A \u044F\u0434\u0430\u043C(\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    \u043D\u0430 q)\n"
