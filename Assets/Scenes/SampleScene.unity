--- !u!114 &1396182968
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1396182966}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21e8d9a604b3e384e8fba3689c30e844, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  message: "\u041E\u0431\u0440\u0430\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043D\u0430 \u043B\u0435\u0432\u044B\u0439 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
    \u0443\u0433\u043E\u043B, \u0442\u0430\u043C \u0442\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C
    3 \u043F\u043E\u043B\u043E\u0441\u043A\u0438. 1 -  \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u0437\u0430 \u0442\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435,
    2 - \u0437\u0430 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0442\u0432\u043E\u0435\u0433\u043E
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0449\u0438\u0442\u0430,
    3 - \u0442\u0432\u043E\u044F \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C
    \u0434\u043B\u044F \u0440\u044B\u0432\u043A\u043E\u0432 \u0438 \u0443\u0432\u043E\u0440\u043E\u0442\u043E\u0432(\u0429\u0438\u0442
    \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043D\u0430
    \u043F\u0440\u043E\u0431\u0435\u043B, \u0440\u044B\u0432\u043E\u043A \u043D\u0430
    \u0448\u0438\u0444\u0442, \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
    \u0435\u0433\u043E \u0441\u0435\u0439\u0447\u0430\u0441!)\n"
