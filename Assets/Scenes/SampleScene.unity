    \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u0434\u043B\u044F \u0431\u043E\u0440\u044C\u0431\u044B
    \u0441 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C\u0438
    \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043C\u043D\u043E\u0433\u043E
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u044F\u0434 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
    \u0438\u043C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0431\u043E\u043B\u044C\u0448\u0435
    \u0443\u0440\u043E\u043D\u0430! \u041D\u0443, \u0430 \u0441\u0432\u044F\u0442\u044B\u0435
    \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u0442\u0435\u0431\u0435 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C
    \u0441\u0432\u044F\u0442\u044B\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432!"
