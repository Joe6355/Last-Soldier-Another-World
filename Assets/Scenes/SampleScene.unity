--- !u!114 &1458757871
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1458757869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21e8d9a604b3e384e8fba3689c30e844, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  message: "\u041D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435 \u0442\u044B
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u043C\u043D\u043E\u0433\u043E
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439,
    \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0442\u044B \u0438\u043D\u043E\u043C\u0438\u0440\u0435\u0446,
    \u0432\u0440\u044F\u0434 \u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u044B\u0435
    \u043B\u044E\u0434\u0438 \u0437\u0430\u0445\u043E\u0442\u044F\u0442 \u0441 \u0442\u043E\u0431\u043E\u0439
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043D\u043E \u041D\u0438\u043A\u043E\u043B\u043E\u0441
    \u044F\u0432\u043D\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0442 \u043F\u0440\u043E\u0434\u0430\u0442\u044C
    \u0442\u0435\u0431\u0435 \u043F\u0430\u0440\u0443 \u0432\u0435\u0449\u0435\u0439)
    \u0435\u0449\u0435 \u043F\u043E \u043E\u0441\u0442\u0440\u043E\u0432\u0443 \u0433\u0443\u043B\u044F\u0435\u0442
    \u0411\u0435\u043A\u0430, \u043E\u043D\u0430 \u0441\u0442\u0435\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0434\u0435\u0432\u043E\u0447\u043A\u0430, \u043D\u043E \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u043C\u043E\u0447\u044C \u0441 \u043E\u0431\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u043C
    \u0430\u0440\u0435\u043D\u044B,\u0436\u0435\u043B\u0430\u044E \u0443\u0434\u0430\u0447\u0438!"
