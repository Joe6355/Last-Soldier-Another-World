--- !u!114 &2028871100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2028871098}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21e8d9a604b3e384e8fba3689c30e844, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  message: "\u041A\u0430\u043A \u0438\u0445 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C?? 
    \u041D\u0443\u0443\u0443 \u044D\u044D\u044D\u044D \u0441\u0432\u044F\u0442\u044B\u0435
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0438 \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430, \u0438 \u043C\u0438\u0433\u0430\u044E\u0442 \u043A\u043E\u0433\u0434\u0430
    \u043F\u043E \u043D\u0438\u043C \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0448\u044C
    \u043D\u0443\u0436\u043D\u044B\u043C \u0442\u0438\u043F\u043E\u043C \u0443\u0440\u043E\u043D\u0430.....\u0410\u0425
    \u0434\u0430, \u0437\u0430\u0431\u044B\u043B\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
    \u0435\u0441\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0441\u0432\u044F\u0442\u044B\u043C\u0438
    \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438 \u043F\u043E \u043E\u0431\u044B\u0447\u043D\u043E\u043C\u0443
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443, \u0442\u043E \u0442\u044B
    \u0431\u0443\u0434\u0435\u0448\u044C \u0435\u0433\u043E \u043B\u0435\u0447\u0438\u0442\u044C.....
    \u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0439
    \u043D\u0430\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C!"
